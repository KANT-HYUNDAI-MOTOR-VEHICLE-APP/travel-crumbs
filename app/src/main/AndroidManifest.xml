<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android Automotive(Pleos Connect) 전용 앱 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 기어(VehicleGear) 읽기 — data/vehicle/VehicleGearDataSource -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 경로 상태 조회(getRouteStateInfo) — data/navi/NaviInfoDataSource -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- LLM SDK 의 모든 호출이 요구(ApiChecker 가 없으면 SecurityException) — data/llm/LlmDataSource -->
    <uses-permission android:name="pleos.car.permission.LLM_SERVICE" />
    <!-- 서버 API 호출(Retrofit 배선) · LLM SDK 자체도 요구 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".TravelCrumbsApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TravelCrumbs">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
