<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android Automotive(Pleos Connect) 전용 앱 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 기어(VehicleGear) 읽기 — data/vehicle/VehicleGearDataSource -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 경로 상태 조회(getRouteStateInfo) — data/navi/NaviInfoDataSource -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- 길안내 요청(requestRoute) — data/navi/NaviInfoDataSource · 스펙 navigation 4.3 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- 서버 API 호출 — 핀의 안내 시작 기록 보내기 · debug 카드 안내 건수(스펙 navigation 4.3 · 4.6) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 연결되면 다시 보내기 — JobScheduler 연결 조건(targetSdk 34 요구) · data/pin(스펙 navigation 4.3 · U30) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 「내비 보기」 — 차량 내비 앱의 실행 Intent 를 찾음(패키지 공개 범위 · targetSdk 30+) · data/navi/NaviAppDataSource(#51 U0) -->
    <queries>
        <package android:name="${naviPackage}" />
    </queries>

    <application
        android:name=".TravelCrumbsApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TravelCrumbs">

        <!--
          창 방향 고정 없음 · 크기 바꿀 수 있음(#51 U0) — Pleos 디자인 가이드 Display Layout 「앱 영역은 앱 1~2개 · 모든 앱은 가로 · 세로 배치 모두에 맞게」.
          에뮬레이터 실측(2026-11-10): 가로 고정이면 나눈 칸(약 817 × 1210 dp)에서 「창 크기를 넓게」만 뜸 · 고정을 빼면 내비(왼쪽) + 이 앱(오른쪽)이 나란히.
          앱이 나눔을 강제할 수 없음(창 제어 권한은 signature|privileged) — 사람이 가운데 ⋮ 를 끌어 나눔.
          주행 중에도 이 화면을 쓰므로 DO(distractionOptimized) 선언 — 주행 중 제한은 코드가(주행 전용 화면 · 스펙 P1).
          singleTop(#51 버그): 기본 standard 면 뿌리와 다른 인텐트(Gleo OPEN_TRAVEL_CRUMBS · am start 뒤 런처)마다 인스턴스가 쌓여
          인스턴스마다 앱 틀 목적지가 따로 → 위가 끝나면 아래의 옛 목적지(추천)가 드러남. 같은 작업 맨 위면 onNewIntent 로 받음.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Gleo Interface — assets/schema.json 의 function 이름과 같은 action.
              Gleo AI 가 context.startActivity() 로 부름(component = "activity").
              실제 Gleo(Pleos Connect v2.1.0 에뮬레이터, 2026-11-10 확인)는 「패키지명.함수명」으로 보냄 —
              공식 예제의 접두어 없는 꼴도 함께 받음(#25).
            -->
            <intent-filter>
                <action android:name="OPEN_TRAVEL_CRUMBS" />
                <action android:name="com.example.travelcrumbs.OPEN_TRAVEL_CRUMBS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 대기 핀 다시 보내기(스펙 navigation 4.6) — 시스템(JobScheduler)만 묶을 수 있음 · 밖에 열지 않음 -->
        <service
            android:name=".data.pin.PinUploadJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>

</manifest>
